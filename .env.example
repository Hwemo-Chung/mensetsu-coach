ANTHROPIC_API_KEY=
# 심사위원에게만 알려줄 접근 코드
ACCESS_CODE=
# 선택: 음성(🔊 읽기, 🎤 답변) — Google Gemini API 키
GEMINI_API_KEY=
# 녹음(🎤 음성 답변·따라 읽기)은 Gemini 유료 등급에서만 1로 켭니다. 무료 등급 약관은 개인정보 전송을 금지합니다.
STT_ENABLED=
# 任意：1 にすると公開モードです。コードなしで1日の上限まで使え、ACCESS_CODE を入力すると上限が外れます。未設定ならコードが必須です。
OPEN_ACCESS=
# 任意（公開モード）：1日の上限です。整数のみで、日本時間0時にリセットします。未設定なら全体 60 回、IP アドレスごと 4 回です。回数は KV_REST_API_* があればそこに、なければサーバーのメモリに保存します。
DAILY_LIMIT=
DAILY_LIMIT_IP=
# 任意：企業・職種の自動調査（ステージ R）を 1 で有効にします。未設定なら従来の動作です。
RESEARCH_ENABLED=
# 任意：面接準備資料を 1 で有効にします。未設定ならボタンを表示しません。
PREP_ENABLED=
# 任意（開発時のみ）：1 にすると検索語を RESEARCH_DEBUG_LOG のファイルに追記します。リポジトリの外の絶対パスを指定してください。本番では無効です。
RESEARCH_DEBUG=
RESEARCH_DEBUG_LOG=
# 任意：メール配信に共通の設定です。RESEND_API_KEY と MAIL_FROM がなければ何も送信しません。保存先（Upstash）は KV_REST_API_* または UPSTASH_REDIS_REST_* です。
RESEND_API_KEY=
MAIL_FROM=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 任意：定期実行と手動再実行の認証、およびメール内のアプリ URL（末尾のスラッシュなし）です。手動再実行は ?date=YYYY-MM-DD で日付を固定できます。
CRON_SECRET=
APP_URL=
# 任意：一般向けのヒントメール登録です。1 のときだけ有効です。未設定なら、API キーがあっても登録画面を表示せず、購読者にも送信しません。
MAIL_PUBLIC=
# 公開時のみ必要：購読者 ID の HMAC 鍵です。ID が変わると既存の配信停止リンクが無効になるため、変更しないでください。
MAIL_SECRET=
# 任意：運営者向けの集計メールです。MAIL_OWNER_TO は受信アドレスです。コードには書かず、ここにだけ設定します。
MAIL_OWNER_TO=
# 20 文字以上のランダムな文字列です（例: openssl rand -hex 32）。短い場合は無効です。ブラウザでアプリの URL に #owner=<この値> を付けて一度開くと、そのブラウザにだけ保存され、URL からは消えます。
MAIL_OWNER_TOKEN=
